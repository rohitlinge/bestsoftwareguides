---
interface Props { big?: boolean; placeholder?: string; id: string; }
const { big = false, placeholder = 'Search software, categories or comparisons', id } = Astro.props;
---
<div class={big ? 'search big' : 'search'} data-search>
  <form action="/search/" method="get" role="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <label class="sr-only" for={id}>Search</label>
    <input id={id} name="q" type="search" autocomplete="off" placeholder={placeholder} aria-autocomplete="list" aria-controls={`${id}-list`} aria-expanded="false" role="combobox" />
    <button type="submit">Search</button>
  </form>
  <ul class="search-results" id={`${id}-list`} role="listbox" hidden></ul>
</div>

<script>
  import { load, search, esc, type Item } from '../lib/search-client';

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const input = root.querySelector('input')!;
    const list = root.querySelector<HTMLUListElement>('.search-results')!;
    const form = root.querySelector('form')!;
    let active = -1;
    let results: Item[] = [];
    const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; };
    const paint = () => {
      list.querySelectorAll('a').forEach((a, i) => a.classList.toggle('active', i === active));
    };
    const render = async () => {
      const q = input.value.trim();
      if (!q) return close();
      results = search(await load(), q);
      list.innerHTML = results.length
        ? results.map((r, i) => `<li role="option" id="${list.id}-${i}"><a href="${r.p}"><span class="logo-tile sm ${r.l ? 'has-img' : r.k === 'Software' ? '' : 'c'}" aria-hidden="true">${esc(r.t[0])}${r.l ? `<img src="${esc(r.l)}" alt="" referrerpolicy="no-referrer" onerror="this.remove()">` : ''}</span><span><strong>${esc(r.t)}</strong><br><span class="small muted">${esc(r.s)}</span></span><span class="kind">${r.k}</span></a></li>`).join('')
        : `<li class="empty">No matches for “${esc(q)}”. Try a category such as CRM or password manager.</li>`;
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    };
    input.addEventListener('focus', () => { load(); if (input.value.trim()) render(); });
    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      const n = results.length;
      if (e.key === 'ArrowDown' && n) { e.preventDefault(); active = (active + 1) % n; paint(); }
      else if (e.key === 'ArrowUp' && n) { e.preventDefault(); active = (active - 1 + n) % n; paint(); }
      else if (e.key === 'Escape') close();
    });
    form.addEventListener('submit', (e) => {
      const pick = results[active >= 0 ? active : -1];
      if (pick) { e.preventDefault(); location.href = pick.p; }
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) close(); });
  }
</script>
