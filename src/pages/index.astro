---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import LogoTile from '../components/LogoTile.astro';
import { categories, tools, compares, site, fmtDate, money, featuredLabel } from '../lib/data';
import { posts, POST_TYPES } from '../lib/posts';
const updated = categories.map((c) => c.updated).sort().pop();
const topics = [...new Set(categories.map((c) => c.topic))];
const popular = topics.map((tp) => categories.find((c) => c.topic === tp)!);
const icon = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<Base title={`${site.name}: Software Rankings, Pricing and Comparisons`} short={[`${site.name}: Software Rankings and Pricing`]} description={site.description} path="/">
  <Fragment slot="hero">
    <span class="eyebrow">Independent · Dated · Sourced</span>
    <h1>Find the right software, with <em>prices you can check.</em></h1>
    <p class="lead">Ranked lists, plan-by-plan pricing and head-to-head comparisons. Every price links to the vendor's page and shows the date we checked it. Scores can't be bought, and featured spots are labelled.</p>
    <Search big id="hero-search" placeholder="Search a tool or category, e.g. CRM, password manager" />
    <div class="chips">
      <span class="label">Popular:</span>
      {popular.map((c) => <a class="chip" href={`/best/${c.slug}/`}>{c.name}</a>)}
    </div>
    <div class="stats">
      <div><strong>{tools.length}</strong>tools tracked</div>
      <div><strong>{categories.length}</strong>categories</div>
      <div><strong>{compares.length}</strong>comparisons</div>
      <div><strong>{updated ? fmtDate(updated) : '—'}</strong>last data check</div>
    </div>
  </Fragment>

  <section>
    <div class="section-head">
      <div>
        <h2>Top-rated software by category</h2>
        <p>The first three in each ranking, with our published score and the entry price.</p>
      </div>
      <a href="/best/">All rankings →</a>
    </div>
    <div class="grid cols-3">
      {categories.map((c) => (
        <a class="card cat-card" href={`/best/${c.slug}/`}>
          <div class="cat-top">
            <LogoTile name={c.name} />
            <div>
              <div class="count">{c.topic}</div>
              <h3>Best {c.name}</h3>
            </div>
          </div>
          <ol class="mini-list">
            {c.tools.slice(0, 3).map((t, n) => (
              <li>
                <span class="pos">{n + 1}</span>
                <LogoTile name={t.name} src={t.logo} size="xs" />
                <span class="nm">{t.name}</span>
                {t.featured
                  ? <span class="badge featured" style="margin:0">{featuredLabel}</span>
                  : <span class="small muted">{t.freePlan ? 'Free plan' : t.entryPrice != null ? `from ${money(t.entryPrice)}` : ''}</span>}
                <span class="score-pill">{t.score}<small>/10</small></span>
              </li>
            ))}
          </ol>
          <span class="more">See all {c.tools.length} · checked {fmtDate(c.updated)} →</span>
        </a>
      ))}
    </div>
  </section>

  <div class="cta-band">
    <div>
      <h2>Down to two options?</h2>
      <p>Side-by-side checks on price, free plans, seats and features, from the same dated data.</p>
    </div>
    <a class="btn white lg" href="/compare/">Browse {compares.length} comparisons</a>
  </div>

  {posts.length > 0 && (
    <section>
      <div class="section-head"><h2>Latest guides</h2><a href="/blog/">All guides →</a></div>
      <div class="grid cols-3">
        {posts.slice(0, 6).map((p) => (
          <a class="card" href={`/blog/${p.slug}/`}>
            <span class="badge blue">{POST_TYPES[p.type]}</span>
            <h3 style="margin:10px 0 6px">{p.title}</h3>
            <div class="small muted">{fmtDate(p.published)} · {p.minutes} min read</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="section-head"><h2>How this site is different</h2><a href="/methodology/">Read the methodology →</a></div>
    <div class="why">
      <div class="card"><span class="ic" set:html={icon('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>')} /><h3>Dated prices</h3><p>Each price shows when it was checked and whether it is verified on the vendor page or reported from a published breakdown.</p></div>
      <div class="card"><span class="ic" set:html={icon('<path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/>')} /><h3>Repeatable scores</h3><p>Scores come from a published formula, not from who paid. <a href="/methodology/">See the formula</a>.</p></div>
      <div class="card"><span class="ic" set:html={icon('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>')} /><h3>Open data</h3><p>All our data is downloadable as <a href="/data/tools.json">JSON</a>, so anyone can check or cite it.</p></div>
    </div>
  </section>
</Base>
