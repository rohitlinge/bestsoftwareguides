---
import Base from '../../../layouts/Base.astro';
import PriceTable from '../../../components/PriceTable.astro';
import Faq from '../../../components/Faq.astro';
import Sources from '../../../components/Sources.astro';
import LogoTile from '../../../components/LogoTile.astro';
import ProductHead from '../../../components/ProductHead.astro';
import Reviews from '../../../components/Reviews.astro';
import { per, lcName, lc1, tools, toolCategory, comparesFor, toolFaqs, priceLine, money, fmtDate, iso, site, alsoRankedIn, rankingsFor, featuredLabel, withArticle, quoteOnly, type Tool } from '../../../lib/data';
import { crumbsLd, faqLd, softwareLd, articleLd } from '../../../lib/ld';

export function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Tool };
const c = toolCategory(t);
const path = `/tools/${t.slug}/`;
const title = `${t.name} Review: Pricing, Pros, Cons and Alternatives`;
const description = `${t.name}: ${t.tagline} ${priceLine(t)}. Ranked #${t.rank} of ${c.tools.length} ${lcName(c.name)} (${t.score}/10). Checked ${fmtDate(t.checked)}.`;
const faqs = toolFaqs(t);
const alts = c.tools.filter((o) => o.slug !== t.slug);
const vs = comparesFor(t);
const jsonld = [
  crumbsLd([{ name: 'Home', path: '/' }, { name: c.name, path: `/best/${c.slug}/` }, { name: t.name, path }]),
  softwareLd(t, c),
  faqLd(faqs),
  articleLd({ headline: title, description, path, published: iso(t.publishDate), modified: t.checked }),
];
const keys = Object.keys(c.featureLabels);
const also = alsoRankedIn(t).filter((x) => x.u.indexable);
// Other categories this tool is ranked in (a tool can sit in several).
const otherCats = rankingsFor(t.slug).filter((x) => x.c.slug !== c.slug);
const featuredIn = rankingsFor(t.slug).filter((x) => x.t.featured);
const rankText = (x: Tool) => (x.featured ? `${featuredLabel}, listed first; #${x.scoreRank} by score` : `#${x.rank}`);
---
<Base title={title} short={[`${t.name} Review: Pricing, Pros and Cons`, `${t.name} Review and Pricing`, `${t.name} Review`]} description={description} path={path} jsonld={jsonld} noindex={!t.indexable} ogType="article" published={iso(t.publishDate)} modified={t.checked}>
  <Fragment slot="band"><ProductHead t={t} c={c} heading={`${t.name} review`} current="overview" /></Fragment>

  <div class="layout">
  <div>
  <div class="meta" style="margin-top:24px">
    <span>#{t.rank} in <a href={`/best/${c.slug}/`}>{c.name}</a></span>
    <span>Score {t.score}/10</span>
    <span>Checked {fmtDate(t.checked)}</span>
    <span>By <a href={site.editor.url}>{site.editor.name}</a></span>
  </div>

  <div class="answer">
    <p><strong>{t.name}</strong> is {withArticle(t.tagline)} {t.featured
      ? <>It is our <span class="badge featured">{featuredLabel}</span> in {lcName(c.name)} and is listed first there; by score it is <strong>#{t.scoreRank} of {c.tools.length}</strong> ({t.score}/10).</>
      : <>It ranks <strong>#{t.rank} of {c.tools.length}</strong> in our {lcName(c.name)} list ({t.score}/10).</>} Best for {lc1(t.bestFor)}.</p>
    {otherCats.length > 0 && <p>Also ranked in {otherCats.map((x, i) => <>{i > 0 && ', '}<a href={`/best/${x.c.slug}/`}>{x.c.name}</a> ({rankText(x.t)}, {x.t.score}/10)</>)}.</p>}
    <p><strong>Price:</strong> {priceLine(t)}.</p>
  </div>

  {featuredIn.length > 0 && <p class="small muted">Disclosure: {t.name} is a featured partner of {site.name} and is listed first in {featuredIn.map((x) => x.c.name).join(', ')}. That does not change its score, pros, cons or prices on this page. <a href="/disclosure/">Read our disclosure</a>.</p>}
  <div class="btn-row">
    <a class="btn" href={t.website} rel="nofollow noopener" target="_blank">Visit {t.name}</a>
    <a class="btn ghost" href={`/tools/${t.slug}/pricing/`}>Full pricing</a>
    <a class="btn ghost" href={`/tools/${t.slug}/alternatives/`}>Alternatives</a>
  </div>

  <h2>What {t.name} is</h2>
  <p class="narrow">{t.description}</p>

  <h2>Pros and cons</h2>
  <div class="pros-cons">
    <div class="card pros"><strong>Where it wins</strong><ul>{t.pros.map((p) => <li>{p}</li>)}</ul></div>
    <div class="card cons"><strong>Where it falls short</strong><ul>{t.cons.map((p) => <li>{p}</li>)}</ul></div>
  </div>

  <Reviews slug={t.slug} name={t.name} />

  <h2>{t.name} pricing</h2>
  <PriceTable tool={t} />

  <h2>Key facts</h2>
  <div class="table-wrap"><table><tbody>
    <tr><th>Free plan</th><td>{t.freePlan ? `Yes. ${t.freePlanDetails ?? ''}` : 'No'}</td></tr>
    <tr><th>Free trial</th><td>{t.trial ?? 'Not advertised'}</td></tr>
    <tr><th>Paid from</th><td>{t.entryPrice != null ? `${money(t.entryPrice)}${per(t)} billed annually` : quoteOnly(t) ? 'Quote-only (contact sales)' : 'See vendor'}{t.entryMonthly != null ? ` · ${money(t.entryMonthly)} monthly` : ''}</td></tr>
    <tr><th>Minimum seats</th><td>{t.minSeats}</td></tr>
    <tr><th>Platforms</th><td>{t.platforms.join(', ')}</td></tr>
    {t.founded && <tr><th>Founded</th><td>{t.founded}{t.hq ? ` · ${t.hq}` : ''}</td></tr>}
    {t.integrations && <tr><th>Integrations</th><td>{t.integrations}</td></tr>}
    {!!t.compliance?.length && <tr><th>Compliance and security</th><td>{t.compliance.join(', ')}</td></tr>}
    {!!t.support?.length && <tr><th>Support</th><td>{t.support.join(', ')}</td></tr>}
    {keys.map((k) => <tr><th>{c.featureLabels[k]}</th><td>{t.features[k] === true ? 'Yes' : t.features[k] === false ? 'No' : 'Not confirmed'}</td></tr>)}
    <tr><th>Facts checked</th><td>{fmtDate(t.checked)} · {t.verification === 'verified' ? "verified on the vendor's own site" : 'reported from published breakdowns'} (<a href={t.pricingUrl} rel="nofollow noopener" target="_blank">source</a>)</td></tr>
  </tbody></table></div>

  {(also.length > 0 || otherCats.length > 0) && (
    <>
      <h2>Also ranked in</h2>
      <p class="narrow">{t.name} is ranked in {also.length + otherCats.length + 1} of our lists: {rankText(t)} of {c.tools.length} in <a href={`/best/${c.slug}/`}>{c.name}</a>, and:</p>
      <div class="grid">
        {otherCats.map((x) => <a class="card" href={`/best/${x.c.slug}/`}><strong>{rankText(x.t)} of {x.c.tools.length}</strong> in {x.c.name}<div class="small muted">Score {x.t.score}/10</div></a>)}
        {also.map((x) => <a class="card" href={x.u.path}><strong>#{x.pos} of {x.of}</strong> in {x.u.name}</a>)}
      </div>
    </>
  )}

  <h2>{t.name} alternatives</h2>
  <div class="grid">
    {alts.map((o) => <a class="card" href={`/tools/${o.slug}/`}><div class="cat-top" style="margin:0 0 8px;display:flex;gap:10px;align-items:center"><LogoTile name={o.name} src={o.logo} size="sm" /><strong style="flex:1">{o.name}</strong><span class="score-pill">{o.score}</span></div><div class="small muted">{o.bestFor}</div></a>)}
  </div>

  {vs.length > 0 && (
    <>
      <h2>{t.name} compared</h2>
      <ul>{vs.map((x) => <li><a href={`/compare/${x.slug}/`}>{x.a.name} vs {x.b.name}</a></li>)}</ul>
    </>
  )}

  <Faq faqs={faqs} />
  <Sources tools={[t]} />
  </div>
  <aside aria-label={`${t.name} at a glance`}>
    <div class="side-card">
      <h4>At a glance</h4>
      <dl class="facts">
        <div><dt>Our score</dt><dd>{t.score}/10</dd></div>
        <div><dt>Rank</dt><dd>{t.featured ? `#${t.scoreRank} by score` : `#${t.rank} of ${c.tools.length}`}</dd></div>
        <div><dt>Free plan</dt><dd>{t.freePlan ? 'Yes' : 'No'}</dd></div>
        <div><dt>Paid from</dt><dd>{t.entryPrice != null ? `${money(t.entryPrice)}${per(t)}` : quoteOnly(t) ? 'Quote' : 'See vendor'}</dd></div>
        <div><dt>Free trial</dt><dd>{t.trial ? 'Yes' : '—'}</dd></div>
        <div><dt>Checked</dt><dd>{fmtDate(t.checked)}</dd></div>
      </dl>
      <div class="btn-row" style="flex-direction:column">
        <a class="btn" href={t.website} rel="nofollow noopener" target="_blank">Visit {t.name}</a>
        <a class="btn ghost" href={`/tools/${t.slug}/pricing/`}>See every plan</a>
      </div>
    </div>
    {vs.length > 0 && (
      <div class="side-card">
        <h4>Compare {t.name}</h4>
        <ul>{vs.slice(0, 6).map((x) => { const o = x.a.slug === t.slug ? x.b : x.a; return <li><a href={`/compare/${x.slug}/`}><LogoTile name={o.name} src={o.logo} size="sm" /><span class="nm">vs {o.name}</span></a></li>; })}</ul>
      </div>
    )}
  </aside>
  </div>
</Base>
