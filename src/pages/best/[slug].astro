---
import Base from '../../layouts/Base.astro';
import RankCard from '../../components/RankCard.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import Faq from '../../components/Faq.astro';
import Sources from '../../components/Sources.astro';
import { lcName, lc1, categories, compares, categoryFaqs, freePagesLive, pluralName, money, fmtDate, iso, buildDate, site, useCases, statSentences, MIN_DIRECTORY_TOOLS, type Category, type Tool, type UseCase } from '../../lib/data';
import { crumbsLd, faqLd, itemListLd, articleLd, collectionLd } from '../../lib/ld';

type Variant = 'main' | 'free' | 'usecase';
export function getStaticPaths() {
  const out: any[] = categories.flatMap((c) => {
    const o: any[] = [{ params: { slug: c.slug }, props: { c, variant: 'main' } }];
    if (freePagesLive(c)) o.push({ params: { slug: `free-${c.slug}` }, props: { c, variant: 'free' } });
    return o;
  });
  for (const u of useCases) out.push({ params: { slug: u.slug }, props: { c: u.category, variant: 'usecase', u } });
  return out;
}
const { c, variant, u } = Astro.props as { c: Category; variant: Variant; u?: UseCase };
const year = buildDate.getUTCFullYear();
const list: Tool[] = variant === 'free' ? c.tools.filter((t) => t.freePlan) : variant === 'usecase' ? u!.tools : c.tools;
const path = variant === 'usecase' ? u!.path : `/best/${variant === 'free' ? 'free-' : ''}${c.slug}/`;
const listName = variant === 'usecase' ? u!.name : variant === 'free' ? `Free ${c.name}` : c.name;
const singular = variant === 'usecase' ? u!.singular : c.singular;
const title = variant === 'free'
  ? `Best Free ${c.name} in ${year}: What Each Free Plan Includes`
  : variant === 'usecase' ? `Best ${u!.name} in ${year}: Ranked with Real Prices`
  : `Best ${c.name} in ${year}: Ranked with Real Prices`;
const top = list[0], second = list[1];
const topFree = top && !top.freePlan ? list.find((t) => t.freePlan) : undefined;
const cheapest = [...list].filter((t) => t.entryPrice != null).sort((a, b) => a.entryPrice! - b.entryPrice!)[0];
const description = variant === 'free'
  ? `${list.length} ${lcName(c.name)} with a free plan, and exactly what each free plan includes. Checked ${fmtDate(c.updated)}.`
  : `The best ${singular} is ${top.name} (${top.score}/10)${second ? `, followed by ${second.name}` : ''}. ${list.length} tools compared on price, free plans and features. Prices checked ${fmtDate(c.updated)}.`;
const stats = statSentences(c, list, variant === 'usecase' ? lcName(u!.name) : pluralName(c));
const faqs = variant === 'free'
  ? list.map((t) => ({ q: `Is ${t.name} free?`, a: `Yes. ${t.freePlanDetails ?? 'It has a free plan.'} Paid plans start at ${t.entryPrice != null ? money(t.entryPrice) + '/user/mo billed annually' : 'see vendor'}.` }))
  : variant === 'usecase'
    ? [{ q: `What is the best ${singular}?`, a: `${top.name} ranks first (${top.score}/10) among the ${list.length} ${lcName(c.name)} that meet this rule: ${lc1(u!.ruleText)}${second ? ` ${second.name} is second (${second.score}/10).` : ''}` }, ...(u!.faqs ?? [])]
    : categoryFaqs(c);
const catCompares = compares.filter((x) => x.category.slug === c.slug && list.some((t) => t.slug === x.a.slug) && list.some((t) => t.slug === x.b.slug));
const siblings = useCases.filter((x) => x.category.slug === c.slug && x.slug !== u?.slug && x.indexable);
const indexable = variant === 'usecase' ? u!.indexable : c.indexable;
const jsonld = [
  crumbsLd([{ name: 'Home', path: '/' }, { name: 'Rankings', path: '/best/' }, ...(variant !== 'main' ? [{ name: c.name, path: `/best/${c.slug}/` }] : []), { name: listName, path }]),
  collectionLd({ name: title, description, path, modified: c.updated }),
  itemListLd({ name: listName, tools: list }, path),
  faqLd([...faqs, ...(variant === 'free' ? [] : stats)]),
  articleLd({ headline: title, description, path, published: iso(variant === 'main' ? c.publishDate : c.comparesDate), modified: c.updated }),
];
---
<Base title={title} description={description} path={path} jsonld={jsonld} noindex={!indexable} ogType="article" published={iso(c.publishDate)} modified={c.updated}>
  <div class="crumbs"><a href="/">Home</a> › <a href="/best/">Rankings</a> › {variant !== 'main' && <><a href={`/best/${c.slug}/`}>{c.name}</a> › </>}{listName}</div>
  <h1>{title}</h1>
  <div class="meta">
    <span>Prices checked {fmtDate(c.updated)}</span>
    <span>{list.length} tools ranked</span>
    <span>By <a href={site.editor.url}>{site.editor.name}</a></span>
    <a href="/methodology/">How we rank</a>
  </div>

  <div class="answer">
    {variant === 'free' ? (
      <p><strong>{list.map((t) => t.name).join(', ')}</strong> have free plans. The highest-ranked is <strong>{top.name}</strong> ({top.score}/10): {top.freePlanDetails}</p>
    ) : (
      <>
        <p><strong>{top.name} is the top-ranked {singular}</strong> of the {list.length} we ranked ({top.score}/10{top.freePlan ? ', free plan' : ''}), best for {lc1(top.bestFor)}. {second && <><strong>{second.name}</strong> is the runner-up ({second.score}/10).</>} {topFree && <>The highest-ranked option with a free plan is <strong>{topFree.name}</strong> ({topFree.score}/10).</>}</p>
        {cheapest && <p>Cheapest paid entry: <strong>{cheapest.name}</strong> at {money(cheapest.entryPrice)}/user/month billed annually.</p>}
      </>
    )}
  </div>

  {variant === 'usecase' ? (
    <>
      <p class="narrow">{u!.intro}</p>
      <p class="narrow"><strong>Included if:</strong> {u!.ruleText} We apply this rule to the same data as the <a href={`/best/${c.slug}/`}>full {lcName(c.name)} ranking</a>, so positions follow the overall score.</p>
      {list.length < MIN_DIRECTORY_TOOLS && <p class="small muted">Fewer than {MIN_DIRECTORY_TOOLS} tools meet this rule today, so search engines are asked not to index this page yet.</p>}
    </>
  ) : <p class="narrow">{c.intro}</p>}

  <h2>{variant === 'free' ? 'Free plans compared' : `Compare ${lcName(listName)} at a glance`}</h2>
  <FeatureTable tools={list} category={c} />

  {variant === 'free' && (
    <div class="table-wrap"><table>
      <thead><tr><th>Tool</th><th>What the free plan includes</th><th>First paid plan</th></tr></thead>
      <tbody>{list.map((t) => <tr><td><a href={`/tools/${t.slug}/`}>{t.name}</a></td><td>{t.freePlanDetails}</td><td>{t.entryPrice != null ? `${money(t.entryPrice)}/user/mo (annual)` : 'See vendor'}</td></tr>)}</tbody>
    </table></div>
  )}

  <h2>{variant === 'free' ? 'The free options' : `The ${list.length} best ${lcName(listName)}`}</h2>
  {list.map((t, i) => <RankCard tool={t} pos={variant === 'main' ? undefined : i + 1} />)}

  {variant === 'usecase' && u!.excluded.length > 0 && (
    <>
      <h2>Not included, and why</h2>
      <ul class="narrow">{u!.excluded.map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a> (#{t.rank} overall) does not meet the rule: {lc1(u!.ruleText)}</li>)}</ul>
    </>
  )}

  {variant !== 'free' && (
    <>
      <h2>Buyer's guide: the numbers</h2>
      <div class="narrow">{stats.map((s) => <p><strong>{s.q}</strong> {s.a}</p>)}</div>
    </>
  )}

  {variant === 'main' && (
    <>
      <h2>How to choose a {c.singular}</h2>
      <ul class="narrow">{c.buyingTips.map((tip) => <li>{tip}</li>)}</ul>
    </>
  )}

  {catCompares.length > 0 && (
    <>
      <h2>Head-to-head comparisons</h2>
      <div class="grid">{catCompares.map((x) => <a class="card" href={`/compare/${x.slug}/`}><strong>{x.a.name} vs {x.b.name}</strong><div class="small muted">{x.a.score} vs {x.b.score} out of 10</div></a>)}</div>
    </>
  )}

  {(siblings.length > 0 || (variant !== 'free' && freePagesLive(c))) && (
    <>
      <h2>More {lcName(c.name)} rankings</h2>
      <div class="grid">
        {variant !== 'main' && <a class="card" href={`/best/${c.slug}/`}><strong>All {c.name}</strong><div class="small muted">{c.tools.length} tools</div></a>}
        {variant !== 'free' && freePagesLive(c) && <a class="card" href={`/best/free-${c.slug}/`}><strong>Free {c.name}</strong><div class="small muted">{c.tools.filter((t) => t.freePlan).length} tools</div></a>}
        {siblings.map((x) => <a class="card" href={x.path}><strong>{x.name}</strong><div class="small muted">{x.tools.length} tools · #1 {x.tools[0].name}</div></a>)}
      </div>
    </>
  )}

  <Faq faqs={faqs} />
  <Sources tools={list} />
  <p class="small muted">Scores come from published, repeatable data (features, free plan, entry price, pricing transparency). No vendor can pay to change a score or a rank. <a href="/methodology/">Read the methodology</a>.</p>
</Base>
