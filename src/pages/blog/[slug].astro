---
import Base from '../../layouts/Base.astro';
import { posts, POST_TYPES, type Post } from '../../lib/posts';
import { fmtDate, site, categories, useCases, lcName } from '../../lib/data';
import { crumbsLd, articleLd } from '../../lib/ld';
export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Post };
const path = `/blog/${p.slug}/`;
const ld = articleLd({ headline: p.title, description: p.description, path, published: p.published, modified: p.updated, type: 'BlogPosting' });
const { Content } = p;
const toc = p.headings.filter((h: any) => h.depth === 2);
const cat = p.category ? categories.find((c) => c.slug === p.category) : undefined;
const catUseCases = cat ? useCases.filter((u) => u.category.slug === cat.slug && u.indexable) : [];
const related = posts.filter((o) => o.slug !== p.slug && (o.category === p.category || o.type === p.type)).slice(0, 3);
---
<Base title={p.title} short={[p.title.split(':')[0]]} description={p.description} path={path} ogType="article" published={p.published} modified={p.updated} jsonld={[crumbsLd([{ name: 'Home', path: '/' }, { name: 'Guides', path: '/blog/' }, { name: p.title, path }]), ld]}>
  <div class="crumbs"><a href="/">Home</a> › <a href="/blog/">Guides</a> › <a href={`/blog/#${p.type}`}>{POST_TYPES[p.type]}</a></div>
  <article class="prose">
    <h1>{p.title}</h1>
    <div class="meta">
      <span>By <a href={site.editor.url}>{site.editor.name}</a></span>
      <span>{p.updated !== p.published ? `Updated ${fmtDate(p.updated)}` : `Published ${fmtDate(p.published)}`}</span>
      <span>{p.minutes} min read</span>
    </div>
    {toc.length > 2 && <nav class="toc"><strong>On this page</strong><ul>{toc.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>}
    <Content />
  </article>

  {cat && (
    <aside class="answer">
      <p><strong>Choosing {lcName(cat.name)}? Compare the options first.</strong> Our <a href={`/best/${cat.slug}/`}>{cat.name} ranking</a> scores {cat.tools.length} tools on price, free plans and features, with every price dated and sourced. #1 right now: {cat.tools[0].name} ({cat.tools[0].score}/10).</p>
      {catUseCases.length > 0 && <p class="small">Narrower lists: {catUseCases.map((u, i) => <>{i > 0 && ' · '}<a href={u.path}>{u.name}</a></>)}</p>}
    </aside>
  )}

  {related.length > 0 && (
    <>
      <h2>Related guides</h2>
      <div class="grid">{related.map((o) => <a class="card" href={`/blog/${o.slug}/`}><span class="small muted">{POST_TYPES[o.type]} · {o.minutes} min read</span><h3>{o.title}</h3></a>)}</div>
    </>
  )}
</Base>
