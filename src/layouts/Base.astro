---
import '../styles/global.css';
import Search from '../components/Search.astro';
import { site, url, categories, PREVIEW, buildDate } from '../lib/data';
interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonld?: any[];
  ogType?: string;
  published?: string;
  modified?: string;
  /** Shorter title variants, used when the title would be too long for search results. */
  short?: string[];
  /** Path of this page's markdown twin (e.g. /best/crm-software.md), advertised to agents. */
  markdown?: string;
}
const { title, description: rawDescription, path, noindex = false, jsonld = [], ogType = 'website', published, modified, short = [], markdown } = Astro.props;
const canonical = url(path);
// Footer social links come from site.sameAs; known networks get an icon (Simple Icons paths).
const SOCIAL: Record<string, { label: string; path: string }> = {
  'youtube.com': { label: 'YouTube', path: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z' },
  'linkedin.com': { label: 'LinkedIn', path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z' },
};
const social = (u: string) => {
  const host = new URL(u).hostname.replace(/^www\./, '');
  return SOCIAL[host] ?? { label: host, path: '' };
};
// Search engines (Bing flags titles over ~70 characters) cut long titles. Use the first candidate
// that fits in 60: the title with the site name, the bare title, then any shorter variants.
const TITLE_MAX = 60;
const candidates = [...(path === '/' ? [] : [`${title} | ${site.name}`]), title, ...short];
const fullTitle = candidates.find((t) => t.length <= TITLE_MAX) ?? candidates.reduce((a, b) => (b.length < a.length ? b : a));
// Meta descriptions over 160 characters get cut: keep whole sentences that fit, else cut at a word.
const DESC_MAX = 160;
const clampDesc = (d: string) => {
  if (d.length <= DESC_MAX) return d;
  const sentences = d.match(/.*?[.!?](?:\s+|$)/gs) ?? []; // a period inside "8.4/10" is not a sentence end
  let out = '';
  for (const s of sentences) { if ((out + s).trim().length > DESC_MAX) break; out += s; }
  if (out.trim().length >= 70) return out.trim();
  return d.slice(0, DESC_MAX - 1).replace(/\s+\S*$/, '').replace(/[,;:·-]\s*$/, '') + '…';
};
const description = clampDesc(rawDescription);
const preview = PREVIEW;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': url('/#organization'), name: site.name, url: site.url,
  logo: url('/logo.png'), email: site.contactEmail, description: site.description,
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: site.contactEmail, url: url('/contact/'), availableLanguage: 'en' },
  ...(site.sameAs?.length ? { sameAs: site.sameAs } : {}),
};
const website = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': url('/#website'), name: site.name, url: site.url,
  description: site.tagline, publisher: { '@id': url('/#organization') }, inLanguage: 'en-US',
};
const graph = [org, website, ...jsonld];
const navItems = [
  { href: '/best/', label: 'Rankings' },
  { href: '/compare/', label: 'Compare' },
  { href: '/blog/', label: 'Guides' },
  { href: '/methodology/', label: 'How we rank' },
];
const section = (href: string) => (path.startsWith(href) || (href === '/best/' && path.startsWith('/tools/')) ? 'page' : undefined);
const hasBand = Astro.slots.has('band');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex || preview ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large'} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={url('/logo.png')} />
  <meta property="og:image:alt" content={site.name} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:image" content={url('/logo.png')} />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  {site.verification?.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
  {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta name="theme-color" content="#07090d" />
  <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
  <link rel="service-desc" type="application/vnd.oai.openapi+json" href="/openapi.json" />
  <link rel="api-catalog" href="/.well-known/api-catalog" />
  <script src="/webmcp.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph.map(({ ['@context']: _, ...g }) => g) })} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/"><img class="logo-mark" src="/logo.svg" width="32" height="32" alt="" /><span class="logo-text">Best<span>Software</span>Guides</span></a>
      {path !== '/' && path !== '/search/' && <Search id="site-search" placeholder="Search software or categories" />}
      <nav class="nav" aria-label="Main">
        {navItems.map((n) => <a href={n.href} aria-current={section(n.href)}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  {Astro.slots.has('hero') && <section class="hero"><div class="wrap"><slot name="hero" /></div></section>}
  {hasBand && <div class="band"><div class="wrap"><slot name="band" /></div></div>}
  <main class="wrap" id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a class="logo" href="/"><img class="logo-mark" src="/logo.svg" width="32" height="32" alt="" /><span class="logo-text">Best<span>Software</span>Guides</span></a>
          <p>{site.tagline}</p>
          <p class="small">Scores come from a published formula. Featured partners are always labelled.</p>
          {site.sameAs?.length > 0 && (
            <ul class="footer-social" aria-label="Follow BestSoftwareGuides">
              {site.sameAs.map((url) => {
                const s = social(url);
                return (
                  <li><a href={url} target="_blank" rel="noopener me" aria-label={s.label} title={s.label}>
                    {s.path ? <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg> : s.label}
                  </a></li>
                );
              })}
            </ul>
          )}
        </div>
        <div>
          <h2>Rankings</h2>
          <ul>{categories.map((c) => <li><a href={`/best/${c.slug}/`}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/best/">All rankings</a></li>
            <li><a href="/compare/">Comparisons</a></li>
            <li><a href="/blog/">Guides</a></li>
            <li><a href="/data/tools.json">Open data (JSON)</a></li>
            <li><a href="/developers/">Developers and API</a></li>
            <li><a href="/ai/">For AI assistants (MCP)</a></li>
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/methodology/">Methodology</a></li>
            <li><a href="/disclosure/">Disclosure</a></li>
            <li><a href="/review-guidelines/">Review guidelines</a></li>
            <li><a href="/contact/">Contact and corrections</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">© {buildDate.getUTCFullYear()} {site.name}. Prices change; always confirm on the vendor's own pricing page before you buy.</div>
    </div>
  </footer>
</body>
</html>
